{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AccelX",
  "version": "0.1.0",
  "identifier": "app.accelx.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:tauri",
    "beforeBuildCommand": "npm run build:tauri",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist-tauri"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AccelX",
        "url": "tauri.html",
        "width": 1100,
        "height": 720,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "shadow": true,
        "center": true,
        "visible": false,
        "backgroundColor": "#0B0B0C"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
